{
  "name": "@snapshot-labs/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Snapshot API",
  "type": "module",
  "scripts": {
    "build": "bun build --entrypoints src/index.ts --outdir dist --target node --external @shutter-network/shutter-crypto",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "eslint src tests",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.45.0",
    "@ethersproject/wallet": "^5.8.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@shutter-network/shutter-crypto": "1.0.1",
    "@snapshot-labs/sx": "^0.1.10",
    "express": "^5.2.1",
    "jose": "^6.2.2",
    "zod": "^3.24.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.0",
  "eslintConfig": {
    "extends": "@snapshot-labs",
    "rules": {
      "import/no-extraneous-dependencies": "off"
    }
  },
  "prettier": "@snapshot-labs/prettier-config",
  "devDependencies": {
    "@snapshot-labs/eslint-config": "^0.1.0",
    "@snapshot-labs/prettier-config": "^0.1.0",
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0"
  }
}
