# Optional: Snapshot API key for higher rate limits
# https://docs.snapshot.box/tools/api/api-keys
SNAPSHOT_API_KEY=

# Optional: Override default API URLs
SNAPSHOT_API_URL=https://hub.snapshot.org/graphql
SEARCH_API_URL=https://search.snapshot.box

# Base URL for OAuth metadata (required for hosted HTTP server)
BASE_URL=https://mcp.snapshot.box

# Wallet configuration for vote (choose one):

# Option 1: Direct private key
ALIAS_PRIVATE_KEY=

# Option 2: Coinbase CDP wallet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
